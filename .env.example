# Copy to .env and fill in to run against the PayPal sandbox. Leave the keys empty for the built-in demo.
# Sandbox keys: developer.paypal.com > Apps & Credentials (Sandbox) > your REST app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the developer dashboard, so PayPal can trigger a sync.
PAYPAL_WEBHOOK_ID=
# Optional: require this token for every change (header x-admin-token).
ADMIN_TOKEN=
